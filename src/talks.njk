---
layout: layouts/base.njk
title: Talks
permalink: /talks/
description: "Talks by Aydin Mohseni on AI safety, metascience, and methods (formal epistemology and game theory)."
---
{%- from "partials/macros.njk" import section with context -%}
{#- Talks grouped by title, one entry per talk with every occasion it was given; upcoming occasions
    are computed at build time from each date (see eleventy.config.js). A talk tied to a paper links
    to that paper's entry on the Publications page. -#}
{%- set pubs = '/publications/' | url -%}
{%- set groups = talks | groupTalks -%}
{%- set upcomingTalks = talks | upcoming | soonestFirst -%}

<section class="hero page-head" aria-labelledby="t-title">
  <h1 id="t-title">Talks</h1>
</section>

{% call section("", "talks") %}
{%- if upcomingTalks.length %}
<h2 class="list-head" id="upcoming">Upcoming</h2>
<ol class="works works--upcoming">
  {%- for t in upcomingTalks %}
  <li class="work talk">
    <div class="work-meta"><span class="year">{{ t.date | formatDate }}</span><span class="type">{{ "Invited talk" if t.invited else "Talk" }}</span></div>
    <div>
      <p class="work-title">{% if t.paper_slug %}<a href="{{ pubs }}#pub-{{ t.paper_slug }}">{{ t.title }}</a>{% else %}{{ t.title }}{% endif %}</p>
      <p class="work-summary">{{ t.venue }}, {{ t.city }}{% if t.with and t.with.length %}. With {% for nm in t.with %}{% if not loop.first %} and {% endif %}{% set u = nm | personUrl(coinquirers) %}{% if u %}<a href="{{ u }}">{{ nm }}</a>{% else %}{{ nm }}{% endif %}{% endfor %}{% endif %}.</p>
    </div>
  </li>
  {%- endfor %}
</ol>
<h2 class="list-head">All talks</h2>
{%- endif %}
<ol class="works">
  {%- for g in groups %}
  {%- set first = g.occasions[0] %}
  {%- set last = g.occasions[g.occasions.length - 1] %}
  {%- set y1 = (last.date | string).slice(0, 4) %}
  {%- set y2 = (first.date | string).slice(0, 4) %}
  <li class="work talk" id="talk-{{ g.title | slugify }}">
    <div class="work-meta"><span class="year">{{ y2 if y1 == y2 else (y1 ~ "&ndash;" ~ y2) | safe }}</span><span class="type">{{ g.occasions.length }} {{ "talk" if g.occasions.length == 1 else "talks" }}</span></div>
    <div>
      <p class="work-title">{% if g.paper_slug %}<a href="{{ pubs }}#pub-{{ g.paper_slug }}">{{ g.title }}</a>{% else %}{{ g.title }}{% endif %}</p>
      <ul class="occasions">
        {%- for t in g.occasions %}
        <li{% if t.verify %} data-verify="{{ t.verify_note }}"{% endif %}>{{ t.venue }}, {{ t.city }}, <span class="nw">{{ t.date | formatDate }}{% if t.upcoming %} (upcoming){% endif %}{% if t.invited %} <span class="inv">invited</span>{% endif %}{% if t.video %} <a class="vid" href="{{ t.video }}">Video</a>{% endif %}</span>{% if t.with and t.with.length %} <span class="inv nw">with {% for nm in t.with %}{% if not loop.first %} and {% endif %}{% set u = nm | personUrl(coinquirers) %}{% if u %}<a href="{{ u }}">{{ nm }}</a>{% else %}{{ nm }}{% endif %}{% endfor %}</span>{% endif %}</li>
        {%- endfor %}
      </ul>
    </div>
  </li>
  {%- endfor %}
</ol>
{% endcall %}
