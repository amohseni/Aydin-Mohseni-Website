---
layout: layouts/base.njk
title: About
permalink: /about/
description: "Aydin Mohseni: biography, research, teaching, appointments and education."
---
{%- from "partials/macros.njk" import section with context -%}
{%- set L = profile.links -%}

{#- The shared page head (eyebrow in the rail, title at page-title size), as on the other
    pages. The portrait leads the Home page, so it is not repeated here. -#}
<section class="hero page-head" aria-labelledby="a-title">
  <p class="eyebrow">About</p>
  <h1 id="a-title">Aydin Mohseni</h1>
  <p class="who">Assistant Professor of Philosophy, Carnegie Mellon University</p>
  <img class="about-photo" src="{{ '/assets/img/about-talk.jpg' | url }}" alt="Aydin Mohseni giving a talk at Carnegie Mellon, beside a slide quoting Nick Bostrom on instrumentally convergent values" width="422" height="360">
</section>

{% call section("Biography", "bio") %}
{%- for para in profile.long_bio %}
<p{% if loop.first and profile.center_name_note %} data-verify="{{ profile.center_name_note }}"{% endif %}>{{ para | linkPhrases(profile.bio_links) | replace("أزرو", '<span lang="ar" dir="rtl">أزرو</span>') | replace("following path: ", 'following path:</p><p class="erdos-path">') | safe }}</p>
{%- endfor %}
{% endcall %}

{% call section("Research", "areas") %}
<dl class="timeline timeline--areas">
  {%- for a in profile.research_areas %}
  <dt>{{ a.area }}</dt>
  <dd>{{ a.topics }}</dd>
  {%- endfor %}
</dl>
{% endcall %}

{% call section("Appointments", "appointments") %}
<dl class="timeline">
  {%- for inst in profile.appointments %}
  {%- for r in inst.roles %}
  <dt>{{ r.years | replace("-", "&ndash;") | safe }}</dt>
  <dd{% if r.verify %} data-verify="{{ r.verify_note }}"{% endif %}>{{ r.title }}, {{ r.unit }}<br><span class="secondary">{{ inst.institution }}</span></dd>
  {%- endfor %}
  {%- endfor %}
</dl>
{% endcall %}

{% call section("Education", "education") %}
<dl class="timeline">
  {%- for e in profile.education %}
  <dt>{{ e.year }}</dt>
  <dd>{{ e.degree }}, {{ e.field }}<br><span class="secondary">{{ e.institution }}</span>{% if e.thesis %}<br><span class="secondary">{{ e.thesis_label }}: <i>{{ e.thesis }}</i>. Committee: {{ e.committee | linkPhrases({}, { people: coinquirers }) | safe }}.</span>{% endif %}</dd>
  {%- endfor %}
</dl>
{% endcall %}

{% call section("Teaching and mentoring", "teaching") %}
<p>I teach decision theory, game theory, AI safety, logic and philosophy of science at Carnegie Mellon, and taught earlier at the University of Pennsylvania and UC Irvine. The full list, with summer schools, is on the <a href="{{ '/teaching/' | url }}">Teaching</a> page. I also mentor AI safety researchers through <a href="https://sparai.org/">SPAR</a> and advise master&rsquo;s students; see <a href="{{ '/contact/' | url }}#mentoring">Contact</a>.</p>
{% endcall %}

{% call section("Colophon", "colophon") %}
<p>This site is set in Computer Modern, the typeface Donald Knuth designed for TeX, in the Computer Modern Unicode versions (SIL Open Font License). The pages are built with Eleventy from data files and served by GitHub Pages.</p>
{% endcall %}
