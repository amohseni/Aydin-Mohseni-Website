---
layout: layouts/base.njk
title: Publications
permalink: /publications/
description: "Papers by Aydin Mohseni on AI safety, metascience, and methods (formal epistemology and game theory)."
---
{%- from "partials/macros.njk" import section, work with context -%}
{#- Structure of exproof.ai publications.html: a count line with jump links, then one section per
    status. Talks and workshops have their own pages. Every work has the anchor #pub-<slug>. -#}
{%- set published = publications | whereStatus("published") -%}
{%- set review = publications | whereStatus("under-review") -%}
{%- set progress = publications | whereStatus("in-progress") -%}

<section class="hero page-head" aria-labelledby="r-title">
  <h1 id="r-title">Publications</h1>
  <p class="who"><a href="#published">Published</a> ({{ published.length }}) · <a href="#under-review">Under review</a> ({{ review.length }}) · <a href="#in-progress">In progress</a> ({{ progress.length }})</p>
</section>

{% call section("Published", "published") %}
<ol class="works">
  {%- for w in published %}
  {{ work(w, people=coinquirers, kind=("Chapter" if w.bibtype == "incollection" else "Article"), cite=true) }}
  {%- endfor %}
</ol>
<p class="more">Years are those of the printed volume. Online-first dates are on the journal pages.</p>
{% endcall %}

{% call section("Under review", "under-review") %}
<ol class="works">
  {%- for w in review %}
  {{ work(w, people=coinquirers, kind=("Revise and resubmit" if w.revise_and_resubmit else "Paper"), cite=true) }}
  {%- endfor %}
</ol>
{% endcall %}

{% call section("In progress", "in-progress") %}
<ol class="works">
  {%- for w in progress %}
  {{ work(w, people=coinquirers, kind="Paper", cite=true) }}
  {%- endfor %}
</ol>
{% endcall %}
